{
  "name": "michigan-politics",
  "private": true,
  "version": "0.1.0",
  "productName": "Michigan Voting Explorer",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "npm run build:electron && electron .",
    "app:dev": "npm run build:electron && ELECTRON_DEV=1 electron .",
    "install:app": "npm run build:electron && node --experimental-strip-types scripts/install-macos-launcher.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --outfile=dist-electron/main.js --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "ingest:census": "tsx scripts/ingest-census.ts",
    "ingest:cvap": "tsx scripts/ingest-cvap.ts",
    "ingest:elections": "tsx scripts/ingest-elections.ts",
    "ingest:geo": "tsx scripts/ingest-geo.ts",
    "seed:polls": "node --experimental-strip-types scripts/seed-polls.ts",
    "validate:polls": "node --experimental-strip-types scripts/validate-polls.ts",
    "test:polls": "node --experimental-strip-types --test scripts/test-polls.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.6.0",
    "esbuild": "^0.25.9",
    "shapefile": "^0.6.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
